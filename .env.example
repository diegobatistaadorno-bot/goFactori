# --- Claude (drawing extraction) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# claude | sidecar  (sidecar = offline demo using samples/drawings/*.json, no API calls)
EXTRACTOR=claude

# --- Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox number by default; your approved WhatsApp sender in production
TWILIO_WHATSAPP_FROM=+14155238886

# Shop owner's personal WhatsApp: receives drafts, approves with "1"
OWNER_WHATSAPP=+1787XXXXXXX

# --- Public URLs (ngrok / cloudflared tunnel, or your VPS domain) ---
# Twilio downloads the quote PDF from here, so it must be reachable from the internet.
PUBLIC_BASE_URL=https://quotes.example.com
N8N_PUBLIC_URL=https://n8n.example.com/
