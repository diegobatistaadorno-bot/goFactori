{
  "id": "waQuoteFollowUp1",
  "name": "WhatsApp quote agent - follow-ups",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "name": "Every 30 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://quote-service:8000/followups/run",
        "options": {
          "timeout": 30000
        }
      },
      "name": "Quote service: due follow-ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "replies",
        "options": {}
      },
      "name": "Follow-up replies",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.twilio.com/2010-04-01/Accounts/{{ $json.account_sid }}/Messages.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/x-www-form-urlencoded",
        "body": "={{ $json.twilio_form }}",
        "options": {}
      },
      "name": "Send WhatsApp (follow-up)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "twilioBasicAuth",
          "name": "Twilio API (Basic Auth)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Twilio Messages API. Swap this node for Meta Cloud API later; the quote service output stays the same.",
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every 30 min": {
      "main": [
        [
          {
            "node": "Quote service: due follow-ups",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Quote service: due follow-ups": {
      "main": [
        [
          {
            "node": "Follow-up replies",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Follow-up replies": {
      "main": [
        [
          {
            "node": "Send WhatsApp (follow-up)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
