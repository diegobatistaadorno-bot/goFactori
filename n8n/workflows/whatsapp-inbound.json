{
  "id": "waQuoteInbound01",
  "name": "WhatsApp quote agent - inbound (Twilio)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "twilio-whatsapp",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Twilio webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "8f3c2a8e-6a51-4d0e-9b8e-3f1d2c7a9b10",
      "notes": "Set this URL in Twilio: Messaging > WhatsApp sandbox settings > 'When a message comes in' (POST)."
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "<Response></Response>",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/xml"
              }
            ]
          }
        }
      },
      "name": "Ack Twilio (empty TwiML)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://quote-service:8000/inbound/twilio",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Twilio webhook').item.json.body) }}"
      },
      "name": "Quote service: inbound",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "replies",
        "options": {}
      },
      "name": "Instant replies",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        680,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.twilio.com/2010-04-01/Accounts/{{ $json.account_sid }}/Messages.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/x-www-form-urlencoded",
        "body": "={{ $json.twilio_form }}",
        "options": {}
      },
      "name": "Send WhatsApp (instant)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        160
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "twilioBasicAuth",
          "name": "Twilio API (Basic Auth)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Twilio Messages API. Swap this node for Meta Cloud API later; the quote service output stays the same.",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-quote-to-process",
              "leftValue": "={{ $('Quote service: inbound').item.json.process_quote_id }}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Needs processing?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        440
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://quote-service:8000/quotes/{{ $('Quote service: inbound').item.json.process_quote_id }}/process",
        "options": {
          "timeout": 240000
        }
      },
      "name": "Quote service: extract + price + draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        420
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "replies",
        "options": {}
      },
      "name": "Draft / follow-up replies",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        1120,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.twilio.com/2010-04-01/Accounts/{{ $json.account_sid }}/Messages.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/x-www-form-urlencoded",
        "body": "={{ $json.twilio_form }}",
        "options": {}
      },
      "name": "Send WhatsApp (draft to owner)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        420
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "twilioBasicAuth",
          "name": "Twilio API (Basic Auth)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Twilio Messages API. Swap this node for Meta Cloud API later; the quote service output stays the same.",
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Twilio webhook": {
      "main": [
        [
          {
            "node": "Ack Twilio (empty TwiML)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ack Twilio (empty TwiML)": {
      "main": [
        [
          {
            "node": "Quote service: inbound",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Quote service: inbound": {
      "main": [
        [
          {
            "node": "Instant replies",
            "type": "main",
            "index": 0
          },
          {
            "node": "Needs processing?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Instant replies": {
      "main": [
        [
          {
            "node": "Send WhatsApp (instant)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs processing?": {
      "main": [
        [
          {
            "node": "Quote service: extract + price + draft",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Quote service: extract + price + draft": {
      "main": [
        [
          {
            "node": "Draft / follow-up replies",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Draft / follow-up replies": {
      "main": [
        [
          {
            "node": "Send WhatsApp (draft to owner)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
